{
	"name": "eslint-plugin-mediawiki",
	"version": "0.8.3",
	"description": "MediaWiki-specific linting rules, for use in MediaWiki core and extensions.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wikimedia/eslint-plugin-mediawiki.git"
	},
	"license": "MIT",
	"keywords": [
		"eslint",
		"eslintplugin",
		"eslint-plugin"
	],
	"main": "src/index.js",
	"scripts": {
		"pretest": "eslint .",
		"test": "c8 mocha --reporter dot tests/ tests/rules/ && mocha --reporter dot tests/integration/ && git diff --exit-code docs/",
		"reporthtml": "c8 report --reporter=html",
		"doc": "del-cli docs/rules/* && cross-env DOCGEN=1 mocha --reporter dot tests/rules/** && eslint-docgen-build-readme",
		"build": "npm run doc"
	},
	"engine": {
		"node": ">=20"
	},
	"files": [
		"src"
	],
	"dependencies": {
		"upath": "^2.0.1"
	},
	"peerDependencies": {
		"eslint": ">=5.0.0"
	},
	"devDependencies": {
		"c8": "12.0.0",
		"cross-env": "^10.1.0",
		"del-cli": "^7.0.0",
		"eslint-config-wikimedia": "^0.32.5",
		"eslint-docgen": "^0.8.0",
		"eslint-plugin-eslint-plugin": "^6.5.0",
		"eslint-plugin-json-es": "^1.6.0",
		"mocha": "^11.7.6",
		"outdent": "^0.8.0",
		"vue-eslint-parser": "^9.4.3"
	},
	"bugs": {
		"url": "https://github.com/wikimedia/eslint-plugin-mediawiki/issues"
	},
	"homepage": "https://github.com/wikimedia/eslint-plugin-mediawiki#readme",
	"directories": {
		"test": "tests"
	}
}
